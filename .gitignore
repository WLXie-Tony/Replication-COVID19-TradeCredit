# --- Stata Ignore Rules ---

# 1. Ignore large data files generated by code
# We want to keep raw data (Excel), but ignore derived dta files to save space
data/derived/*.dta
data/derived/*.tmp

# 2. Ignore Stata temporary and system files
*.tmp
*.bak
*.stpr
__*

# 3. Ignore Log files (unless you specifically want to share them)
*.log
*.smcl

# 4. Ignore Graphs (usually we only want final outputs, not temp graphs)
*.gph

# 5. Ignore Stata estimation results (unless needed)
*.ster

# 6. Operating System junk files
.DS_Store
Thumbs.db
